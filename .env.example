# =============================================================================
# Environment variables for youtube-rag and docker compose.
#
# Copy to .env and fill in secrets (never commit .env with real keys):
#   cp .env.example .env
#
# Docker Compose loads .env from this directory for ${VAR} substitution.
# =============================================================================

# --- Flask app (config.py) ---
DEBUG=false
LOG_LEVEL=INFO
PORT=5004
CORS_ORIGINS=*

DOWNLOAD_FOLDER=/app/docs/mp3
TEXT_FOLDER=/app/docs/txt

# PostgreSQL (Flask: youtube_videos). In compose, match POSTGRES_* below unless you override the URI.
POSTGRES_CONNECTION_URI=postgresql://postgres:postgres@127.0.0.1:5432/youtube_rag

# OpenAI-compatible URL + key (Flask: paths that still call OpenAI-compatible clients)
OPENAI_API_KEY=
OPENAI_BASE=http://127.0.0.1:8001/v1

# Embedding model metadata (config.py; used where the app still reads these)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

MODEL=gemma2:27b
OLLAMA_HOST=http://127.0.0.1:11434

API_URL=http://127.0.0.1:5005/transcribe

COLLECTION_NAME=youtube_finance_docs

# --- Remote LightRAG HTTP client (config.py / lightrag_remote.py) ---
LIGHTRAG_SERVICE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_BEARER_TOKEN=
LIGHTRAG_REQUEST_TIMEOUT=300
LIGHTRAG_QUERY_MODE=hybrid
LIGHTRAG_USER_PROMPT=

# =============================================================================
# docker compose — Postgres (service: postgres)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youtube_rag

# =============================================================================
# docker compose — LightRAG container (OpenAI-compatible LLM + embeddings)
# =============================================================================
# Base URL including /v1 (required for compose up unless OPENAI_LLM_BASE is set).
OPENAI_COMPAT_BASE=https://api.openai.com/v1

# Optional: split endpoints (each must include /v1 when the provider expects it).
OPENAI_LLM_BASE=
OPENAI_EMBEDDING_BASE=
OPENAI_EMBEDDING_API_KEY=

# Chat model on the LightRAG server (compose uses LIGHTRAG_LLM_MODEL, then LLM_MODEL, then default).
LIGHTRAG_LLM_MODEL=
LLM_MODEL=gpt-4o-mini

# Embedding model + dimension on the LightRAG server (separate from Flask EMBEDDING_* above).
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
LIGHTRAG_EMBEDDING_DIM=1536

# =============================================================================
# docker compose — LightRAG server (optional; when running lightrag-server yourself)
# =============================================================================
HOST=0.0.0.0
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs
LLM_BINDING=openai
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=

# =============================================================================
# Misc
# =============================================================================
TZ=America/New_York
