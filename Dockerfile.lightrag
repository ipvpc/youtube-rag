FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir "lightrag-hku>=1.4.6"

RUN mkdir -p /app/rag_storage /app/inputs

ENV WORKING_DIR=/app/rag_storage
ENV INPUT_DIR=/app/inputs
ENV HOST=0.0.0.0
ENV PORT=9621

EXPOSE 9621

HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=8 \
    CMD curl -sf "http://127.0.0.1:9621/health" >/dev/null || exit 1

CMD ["lightrag-server"]
